  "description": "Local-first pet care planner for iPhone and iPad",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint App.tsx src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "audit:motion-assets": "node scripts/audit-pet-motion-assets.mjs",
    "audit:pet-chroma": "node scripts/audit-pet-chroma.mjs",
