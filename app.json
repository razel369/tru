    },
    "android": {
      "package": "app.raintank.planner",
      "adaptiveIcon": {
        "backgroundColor": "#E7F7F4"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
